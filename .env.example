# ===== 复制为 .env 使用（.env 已被 .gitignore 忽略，不会提交）=====
# docker compose 会读取本目录 .env；修改后需 docker compose up -d 重新创建容器。

# ===== PostgreSQL =====
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password
POSTGRES_DB=rag_knowledge

# ===== 鉴权 =====
# 生产环境务必替换为随机长字符串
JWT_SECRET=please-change-me-in-production

# ===== Embedding（硅基流动 bge-m3，1024 维）=====
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# 必须与已有 ES 索引维度一致；换维度需删除索引后重建
EMBEDDING_DIM=1024

# ===== LLM（智谱 GLM，OpenAI 兼容接口）=====
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash-250414
# 主模型限流/不可用时依次降级，逗号分隔
LLM_FALLBACK_MODELS=glm-4.7-flash

# ===== 检索阈值 =====
# hybrid 的 score 是 RRF 融合分（0.01-0.03 量级），0.02 为实测值
RELEVANCE_THRESHOLD=0.02
# 语义二次验证：RRF 分或余弦相似度任一达标即相关
RELEVANCE_COS_THRESHOLD=0.5
# 拼入 prompt 的来源字符预算
CTX_BUDGET_CHARS=2600

# ===== 上传 =====
MAX_UPLOAD_SIZE_MB=20
