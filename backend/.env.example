# FastAPI 应用配置（复制为 backend/.env 使用）

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://rag:rag_dev_password@localhost:5432/rag_knowledge
# Alembic 迁移用同步驱动（同样指向本地 PG 容器）
SYNC_DATABASE_URL=postgresql+psycopg2://rag:rag_dev_password@localhost:5432/rag_knowledge

# ===== Elasticsearch =====
ES_URL=http://localhost:9200
ES_INDEX=rag_chunks
# 维度唯一事实来源：mock 向量 / ES mapping dims / 写入断言 都由它派生
EMBEDDING_DIM=1536

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
JWT_SECRET=please-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 上传限制 =====
# 文档上传大小上限（MB），nginx 的 client_max_body_size 需同步改大
MAX_UPLOAD_SIZE_MB=20

# ===== 检索相关判定 =====
# 语义二次验证：RRF 分 或 余弦相似度任一达标即相关（bge-m3 真相关 0.64+，无关 <0.45）
RELEVANCE_COS_THRESHOLD=0.5

# ===== 模型 Provider =====
# embedding: mock | openai
EMBEDDING_PROVIDER=mock
# OpenAI 兼容 embeddings。text-embedding-3-small 为 1536 维，与 EMBEDDING_DIM 一致，切过去无需重建 ES 索引。
# 若换成其它维度模型：必须同步改 EMBEDDING_DIM 并删除 ES 索引重建（启动时 dims 不一致会拒绝启动）。
# 注意：DeepSeek 不提供 embeddings，需用 OpenAI 或其它 OpenAI 兼容网关（如硅基流动 SiliconFlow 等）。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# llm: mock | openai（默认 DeepSeek，OpenAI 兼容 chat completions）
# 注意：deepseek-chat 已于 2026-07-24 停用，官方模型为 deepseek-v4-flash / deepseek-v4-pro
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 相关度阈值：hybrid 模式 score 是 RRF 融合分（量级 0.01-0.03），0.02 为实测值
RELEVANCE_THRESHOLD=0.02

# ===== 默认管理员（首次启动种子）=====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
